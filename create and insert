-- ====================================================================
-- PHASE 1: CLEAN SLATE SETUP (Drops existing objects to avoid errors)
-- ====================================================================
DROP TABLE IF EXISTS group_membership CASCADE;
DROP TABLE IF EXISTS study_group CASCADE;
DROP TABLE IF EXISTS study_material CASCADE;
DROP TABLE IF EXISTS session CASCADE;
DROP TABLE IF EXISTS service CASCADE;
DROP TABLE IF EXISTS student CASCADE;
DROP TABLE IF EXISTS subject CASCADE;
DROP TABLE IF EXISTS department CASCADE;
DROP TYPE IF EXISTS session_status_type;

-- ====================================================================
-- PHASE 2: DATA STRUCTURE DEFINITIONS (Creating your Tables)
-- ====================================================================
CREATE TYPE session_status_type AS ENUM ('pending', 'confirmed', 'cancelled', 'completed');

CREATE TABLE department (
    department_id SERIAL PRIMARY KEY,
    department_name VARCHAR(100) NOT NULL
);

CREATE TABLE subject (
    subject_id SERIAL PRIMARY KEY,
    subject_name VARCHAR(100) NOT NULL,
    department_id INT NOT NULL REFERENCES department(department_id) ON DELETE CASCADE
);

CREATE TABLE student (
    student_id SERIAL PRIMARY KEY,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    bio TEXT,
    registration_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE service (
    service_id SERIAL PRIMARY KEY,
    mentor_id INT NOT NULL REFERENCES student(student_id) ON DELETE CASCADE,
    subject_id INT NOT NULL REFERENCES subject(subject_id) ON DELETE CASCADE,
    service_type VARCHAR(100) NOT NULL,
    description TEXT
);

CREATE TABLE session (
    session_id SERIAL PRIMARY KEY,
    mentor_id INT NOT NULL REFERENCES student(student_id),
    student_id INT NOT NULL REFERENCES student(student_id),
    service_id INT NOT NULL REFERENCES service(service_id) ON DELETE CASCADE,
    scheduled_time TIMESTAMP NOT NULL,
    actual_start_time TIMESTAMP,
    actual_end_time TIMESTAMP,
    session_status session_status_type DEFAULT 'pending',
    meeting_link VARCHAR(255),
    rating_by_student INT CHECK (rating_by_student BETWEEN 1 AND 5),
    review_by_student TEXT,
    CONSTRAINT chk_not_self_booking CHECK (mentor_id <> student_id)
);

CREATE TABLE study_material (
    material_id SERIAL PRIMARY KEY,
    uploader_id INT NOT NULL REFERENCES student(student_id) ON DELETE CASCADE,
    subject_id INT NOT NULL REFERENCES subject(subject_id) ON DELETE CASCADE,
    title VARCHAR(150) NOT NULL,
    description TEXT,
    file_path_url VARCHAR(512) NOT NULL,
    upload_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE study_group (
    group_id SERIAL PRIMARY KEY,
    group_name VARCHAR(150) NOT NULL,
    description TEXT,
    created_by_student_id INT NOT NULL REFERENCES student(student_id) ON DELETE CASCADE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE group_membership (
    membership_id SERIAL PRIMARY KEY,
    group_id INT NOT NULL REFERENCES study_group(group_id) ON DELETE CASCADE,
    student_id INT NOT NULL REFERENCES student(student_id) ON DELETE CASCADE,
    role VARCHAR(50) DEFAULT 'member',
    joined_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT unique_group_user UNIQUE (group_id, student_id)
);

CREATE INDEX idx_session_scheduled ON session(scheduled_time);
CREATE INDEX idx_student_email ON student(email);

